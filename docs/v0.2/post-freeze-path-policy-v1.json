  "phaseRules": {
    "pre-run": {
      "headMustEqualAcceptedPredecessorMainHead": true,
      "completedStagesEndAtImmediatePredecessor": true,
      "currentStageRequiredOutputsMustBeAbsent": true,
      "currentStageAllowedPathsMustBeUnchanged": true
    },
    "evidence-pr": {
      "headMustEqualReviewedPrHead": true,
      "completedStagesIncludeCurrentStage": true,
      "currentStageRequiredOutputsMustExist": true,
      "diffAgainstAcceptedPredecessorUsesCurrentStageAllowlist": true
    },
    "post-merge": {
      "headMustEqualMergedMainHead": true,
      "completedStagesIncludeCurrentStage": true,
      "currentStageRequiredOutputsMustExist": true,
      "uniqueMergedPrAndOfficialPostMergeRunRequired": true
    }
  },
  "frozenChecks": {
    "validationFreezeIsAncestor": true,
    "allSevenManifestPreimagesAndEntriesMatchFreezeBlobs": true,
    "allFiveWorkflowCandidateLivePairsAreByteEqual": true,
    "candidateAndLiveWorkflowSetIsExact": true,
    "candidateTupleRecomputesFromFreezeLocksAndManifests": true,
    "firstParentMainHistoryOnly": true,
    "githubMergedPrAndOfficialRunIdentityRequired": true,
    "previousStagePathsImmutableAfterAcceptedMerge": true,
    "pathOutsideCompletedStageUnionFails": true
  },
