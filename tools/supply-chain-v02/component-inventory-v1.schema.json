{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaokh31.github.io/androidAppHardening/v0.2/component-inventory-v1.schema.json",
  "title": "v0.2 Toolchain Component Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseLine", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseLine": { "const": "v0.2" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bomRef", "name", "version", "sourceProfile", "coverageClass", "artifacts"],
        "properties": {
          "bomRef": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sourceProfile": { "type": "string", "minLength": 1 },
          "coverageClass": { "enum": ["osv-package", "native-vendor-advisory", "first-party-source", "tool-binary"] },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "sizeBytes", "sha256"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "sizeBytes": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
