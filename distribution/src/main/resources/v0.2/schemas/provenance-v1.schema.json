{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaokh31.github.io/androidAppHardening/v0.2/provenance-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceCommit", "toolchainManifestSha256", "componentManifestSha256", "archiveSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "toolchainManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
